---
// Live FPGA Lab widget (spec §7.2). Server-rendered = the no-JS static panel; board-client.ts fills the live fields.
import '../styles/widget.css';
---
<div class="board" data-state="static" aria-live="polite">
  <div class="band">
    <span class="title"><span class="socket" aria-hidden="true"><i class="sdot"></i></span>Live FPGA Lab</span>
    <svg class="pins" width="66" height="13" viewBox="0 0 66 13" aria-hidden="true">
      {[0, 1, 2, 3].map((i) => <circle cx={6.5 + i * 17.7} cy="6.5" r="5.5" fill="#d8b46a" stroke="#a8873f" stroke-width="2" />)}
    </svg>
  </div>
  <div class="body">
    <p class="what">A real FPGA board in my homelab. Anyone can run demos on it from the browser.</p>
    <div class="runrow">
      <div class="running" data-live>
        <small data-f="label"></small>
        <b data-f="headline"></b>
        <span data-f="sub"></span>
      </div>
      <div class="actions">
        <a class="btn btn-live" href="https://fpga.njason.dev">Open the lab</a>
        <div class="tags" data-live>
          <span class="tag" data-f="queue-tag">Queue <b data-f="queue"></b></span>
          <span class="tag" data-f="temp-tag"><b data-f="temp"></b></span>
        </div>
      </div>
    </div>
  </div>
</div>
