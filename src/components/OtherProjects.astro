---
// Other projects (spec §5.1 item 5): the smaller course projects, one card per course, each row opening its
// section on the course page. Groups follow the projects' own order.
import { getCollection, getEntry } from 'astro:content';
import { projectHref } from '../lib/links';
import '../styles/other.css';

const small = (await getCollection('projects', (p) => !p.data.main && !!p.data.course)).sort((a, b) => a.data.order - b.data.order);
const codes = [...new Set(small.map((p) => p.data.course!.id))];
const groups = await Promise.all(
  codes.map(async (id) => {
    const c = (await getEntry('courses', id))!;
    return { name: `${c.data.code} ${c.data.name}`, rows: small.filter((p) => p.data.course!.id === id) };
  }),
);
---
<section id="other" class="sec" aria-labelledby="other-h">
  <h2 id="other-h" data-pad>Other projects</h2>
  <p class="lead">Smaller course projects, grouped by course. Each opens its section on the course page.</p>
  <div class="groups">
    {groups.map((g) => (
      <div class="group">
        <h3>{g.name}</h3>
        <div class="mini">
          {g.rows.map((p) => (
            <a href={projectHref({ id: p.id, kind: p.data.kind, course: p.data.course?.id })}><b>{p.data.title}</b><small>{p.data.headline}</small></a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
