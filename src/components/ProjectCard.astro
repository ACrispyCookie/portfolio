---
// Project card (spec §7.5): picture or video, name, headline, its pills (src/lib/pills.ts) and who built it as avatars
// (only mine on solo work).
// The whole card is one link: name and headline sit inside it and it stretches over the card; tags, avatars and
// the demo button sit above it. Text inside the link keeps it from being covered by the stretched layer.
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Avatars from './Avatars.astro';
import { diagrams } from './diagrams';
import OnFpga from './OnFpga.astro';
import { projectHref } from '../lib/links';
import Pills from './Pills.astro';
import { toolTags } from '../lib/tools';

// `tools`: show the project's tools as pills (the All projects page)
interface Props { project: CollectionEntry<'projects'>; size: 'wide' | 'large' | 'compact' | 'personal'; tools?: boolean }
const { project, size } = Astro.props;
const t = Astro.props.tools ? toolTags(project.data.tools) : null;
const p = project.data;
const href = projectHref({ id: project.id, kind: p.kind, course: p.course?.id });
const team = p.team.map((t) => t.id);
const Diagram = diagrams[p.diagram ?? 'runtime'];
const sizes = { wide: '(max-width: 760px) 100vw, 640px', large: '(max-width: 760px) 100vw, 560px', compact: '(max-width: 760px) 120px, 220px', personal: '(max-width: 760px) 100vw, 380px' }[size];
---
<article class={`card ${size}`} data-id={project.id} data-size={size}>
  <div class:list={['media', { paper: p.media?.paper }]}>
    {p.media?.video ? (
      <video src={p.media.video} poster={p.media.video.replace(/\.mp4$/, '.jpg')} muted loop playsinline preload="none" aria-label={p.media.alt}></video>
    ) : p.media ? (
      <Picture src={p.media.src} formats={['avif', 'webp']} widths={[240, 480, 720, 1080]} sizes={sizes} alt={p.media.alt} loading="lazy" style={p.media.position ? `object-position:${p.media.position}` : undefined} />
    ) : (
      <Diagram milestones={p.milestones} />
    )}
    {p.media?.overlay === 'fpga' && <OnFpga />}
  </div>
  <div class="body">
    <a class="hit" href={href}>
      <h3>{p.title}</h3>
      <p class="head">{p.headline}</p>
      {size === 'wide' && <p class="sum">{p.summary}</p>}
    </a>
    {t && <span class="tools">{t.shown.map((x) => <span class="tag">{x}</span>)}{t.rest.length > 0 && <span class="tag more" title={t.rest.join(', ')}>+{t.rest.length}</span>}</span>}
    <div class="meta">
      <Pills project={project} />
      <div class="row">
        {/* any project that runs in the lab, unless the card itself already goes there */}
        {p.links.demo && href !== p.links.demo && <a class="btn btn-live" href={p.links.demo}>Run the demo</a>}
        {/* who built it: me, then the team (a solo project shows only me) */}
        <Avatars handles={['jason', ...team]} />
      </div>
    </div>
  </div>
</article>
