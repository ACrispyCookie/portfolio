---
// A project's own page (spec §5.2). Everything comes from the project's entry: the header pills and buttons from its
// data, the sections from its Markdown `##` headings in their own order (each project has its own: Jason, 2026-10-24),
// the key numbers and result bars from its frontmatter. A section with no true content is simply absent, and the
// contents list follows what is there.
import { existsSync } from 'node:fs';
import sharp from 'sharp';
import { Picture } from 'astro:assets';
import { getCollection, getEntries, getEntry, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Pills from './Pills.astro';
import OnFpga from './OnFpga.astro';
import Toc from './Toc.astro';
import KeyNumbers from './KeyNumbers.astro';
import ResultBars from './ResultBars.astro';
import Team from './Team.astro';
import NextCard from './NextCard.astro';
import PrevNext from './PrevNext.astro';
import Skills from './Skills.astro';
import { diagrams, shapes } from './diagrams';
import { courseHref, pageHref } from '../lib/links';
import { docsFor } from '../lib/docs';
import ProjectFigure from './ProjectFigure.astro';
import { buildSkillIndex, toSkillProjects } from '../lib/skills';
import skills from '../data/skills.json';
import evidence from '../data/skills-evidence.json';
import '../styles/projects.css';
import '../styles/project.css';

interface Props { entry: CollectionEntry<'projects'> }
const { entry } = Astro.props;
const p = entry.data;
const course = p.course ? await getEntry('courses', p.course.id) : undefined;

// the page's sections, in the Markdown's own order: What it is first; Team, Tools and the report after them
const strip = (s: string) => s.replace(/<[^>]+>/g, '').replace(/&#39;|&#x27;/g, "'").replace(/&amp;/g, '&').trim();
const H2 = /^<h2 id="([^"]+)">([\s\S]*?)<\/h2>/;
const md = new Map<string, { title: string; html: string }>();
for (const chunk of (entry.rendered?.html ?? '').split(/(?=<h2 id=")/)) {
  const m = H2.exec(chunk);
  if (m) md.set(m[1], { title: strip(m[2]), html: chunk.slice(m[0].length) });
}
// a page opens with What it is, or What we showed on a security project (approved draft, 2026-10-24)
if (!['what-it-is', 'what-we-showed'].includes([...md.keys()][0])) throw new Error(`${entry.id}: the first section must be "What it is" or "What we showed"`);
for (const id of ['team', 'tools', 'docs']) if (md.has(id)) throw new Error(`${entry.id}: "${id}" is the page's own section`);
// the result bars sit under Results, or under the section the data names (RAMBO: What we measured)
const resultsAt = p.results?.section ?? 'results';
if (p.results && !md.has(resultsAt)) md.set(resultsAt, { title: 'Results', html: '' });
// a project in progress: What's next is its milestones still to do, from its data
const todo = (p.milestones ?? []).filter((m) => m.state !== 'done');
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
// (the Markdown's own What's next text, if any, follows the list)
if (todo.length) md.set('whats-next', { title: "What's next", html: `<ul>${todo.map((m) => `<li>${m.state === 'now' ? 'Now' : 'Next'}: ${esc(m.name)}</li>`).join('')}</ul>${md.get('whats-next')?.html ?? ''}` });
if (p.next && !md.has('whats-next')) md.set('whats-next', { title: "What's next", html: '' });
// each section in parts, one per sub-heading, so a picture can sit under the step it explains (Jason, 2026-10-25)
const H3 = /<h3 id="([^"]+)"/;
const sections = [...md].map(([id, s]) => ({ id, ...s, parts: s.html.split(/(?=<h3 id=")/).map((html) => ({ id: H3.exec(html)?.[1], html })) }));
const anchors = new Set(sections.flatMap((s) => [s.id, ...s.parts.map((x) => x.id).filter(Boolean)]));
const lost = (p.figures ?? []).filter((f) => !anchors.has(f.section));
if (lost.length) throw new Error(`${entry.id}: figures for missing sections: ${lost.map((f) => f.section).join(', ')}`);
const docs = docsFor({ id: entry.id, course: p.course?.id }, existsSync);
// the hero keeps its picture's own shape, so nothing is cut off (Jason, 2026-10-25: hero pictures were cropped);
// a video's shape is its poster's, which is cut from the video at full size. A very tall or very wide picture
// gets a box at the nearest usable shape and is shown whole inside it.
const own = p.media?.video ? await sharp(`public${p.media.video.replace(/\.mp4$/, '.jpg')}`).metadata() : p.media?.src;
const ownAr = own ? own.width! / own.height! : 320 / 200; // a drawn hero: the drawings' own 16:10 frame
const heroAr = Math.min(2.4, Math.max(4 / 3, ownAr));
const heroFit = Math.abs(heroAr / ownAr - 1) > 0.01;

const members = await getEntries([{ collection: 'collaborators' as const, id: 'jason' }, ...p.team.map((t) => ({ collection: 'collaborators' as const, id: t.id }))]);

// Tools: the skills explorer limited to this project's tools, in the project's own order (what defines it first)
const projects = await getCollection('projects');
const courses = await getCollection('courses');
const codes = Object.fromEntries(courses.map((c) => [c.id, c.data.code]));
const index = buildSkillIndex(toSkillProjects(projects.map((x) => ({ ...x.data, id: x.id, course: x.data.course?.id })), codes, skills.origin), { coursework: evidence.coursework });
const tools = p.tools.map((t) => index.find((e) => e.tool === t)!).filter(Boolean);
const self = pageHref({ id: entry.id, kind: p.kind, course: p.course?.id, main: p.main });

const docsTitle = docs.map((d) => d.label).join(' and ');
const toc = [...sections.map(({ id, title }) => ({ id, title })), ...(docs.length ? [{ id: 'docs', title: docsTitle }] : []), { id: 'team', title: 'Team' }, { id: 'tools', title: 'Tools' }];
const Diagram = diagrams[p.diagram ?? 'runtime'];
---
<Base title={`${p.title} | Jason Nikas`} description={p.headline}>
  <header class="phead" data-trace-start="wide">
    {course && (
      <nav class="crumb" aria-label="Breadcrumb">
        <a href={courseHref(course.id)}>{course.data.code} {course.data.name}</a> / <span aria-current="page">{p.title}</span>
      </nav>
    )}
    <h1>{p.title}</h1>
    <p class="lead">{p.headline}</p>
    <div class="pills"><Pills project={entry} hide={['course']} /></div>
    {(p.links.demo || p.links.repo || docs.length > 0) && (
      <div class="btns">
        {p.links.demo && <a class="btn btn-live" href={p.links.demo}>Run the demo</a>}
        {p.links.repo && <a class="btn btn-secondary" href={p.links.repo}>Code</a>}
        {docs.map((d) => <a class="btn btn-secondary" href={d.href} target="_blank" rel="noopener">{d.label}</a>)}
      </div>
    )}
  </header>

  <!-- the video and its numbers, one block; on a phone it spans the full width and the copper starts under it -->
  <div class="ptop" data-trace-start="phone" style={`--har:${heroAr.toFixed(3)}`}>
  <figure class:list={['hero-media', { paper: p.media?.paper, whole: heroFit }]}>
    {p.media?.video ? (
      <video src={p.media.video} poster={p.media.video.replace(/\.mp4$/, '.jpg')} muted loop playsinline preload="none" aria-label={p.media.alt}></video>
    ) : p.media ? (
      <Picture src={p.media.src} formats={['avif', 'webp']} widths={[480, 720, 1080, 1440]} sizes="(max-width: 760px) 100vw, 1064px" alt={p.media.alt} style={p.media.position ? `object-position:${p.media.position}` : undefined} />
    ) : (
      <Diagram milestones={p.milestones} />
    )}
    {p.media?.overlay === 'fpga' && <OnFpga />}
  </figure>

  {p.numbers && <KeyNumbers numbers={p.numbers} />}
  </div>

  <div class="pbody"><div class="pgrid">
    <Toc items={toc} />
    <div class="psecs">
      {sections.map((s) => (
        <section id={s.id} class="sec psec" aria-labelledby={`${s.id}-h`}>
          <h2 id={`${s.id}-h`} data-pad>{s.title}</h2>
          {s.id === resultsAt && p.results && (
            <>
              <p>{p.results.text}</p>
              {p.results.bars && <ResultBars bars={p.results.bars} />}
            </>
          )}
          {s.parts.map((part) => (
            <>
              <Fragment set:html={part.html} />
              {part.id && (p.figures ?? []).filter((f) => f.section === part.id).map((f) => <ProjectFigure f={f} />)}
            </>
          ))}
          {s.id === 'whats-next' && p.next && <NextCard id={p.next.id} />}
          {(p.figures ?? []).filter((f) => f.section === s.id).map((f) => <ProjectFigure f={f} />)}
        </section>
      ))}
      {docs.length > 0 && (
        <section id="docs" class="sec psec" aria-labelledby="docs-h">
          <h2 id="docs-h" data-pad>{docsTitle}</h2>
          <ul class="docs">
            {docs.map((d) => (
              <li class="doc panel">
                <span class="sheet" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
                <span class="what"><b>{d.label}</b><span>PDF, opens in a new tab</span></span>
                <span class="acts">
                  <a class="btn btn-secondary" href={d.href} target="_blank" rel="noopener">Read</a>
                  <a class="btn btn-secondary" href={d.href} download={`${p.title} - ${d.label}.pdf`}>Download</a>
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}
      <Team members={members} />
      <Skills entries={tools} self={self} id="tools" heading="Tools" intro="What this project was built with. Pick one to see where else I used it." />
    </div>
  </div></div>

  <PrevNext current={entry.id} />
  <dialog class="viewer" aria-label="Picture, full size">
    <div class="stage"></div>
    <button class="btn btn-secondary close" type="button">Close</button>
    <p class="hint" aria-live="polite">Tap the picture to see it at full size</p>
  </dialog>
</Base>
<script>
  import '../scripts/skills';
  import '../scripts/videos';
  import '../scripts/toc';
  import '../scripts/zoom';
</script>
