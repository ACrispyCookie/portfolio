---
// Who built it (spec §5.2): me first, then the team, each with their face and their own links; one panel of rows,
// never a row of identical icon cards.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { initialsOf } from '../lib/avatars';

interface Props { members: CollectionEntry<'collaborators'>[] }
const { members } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/avatars/*.jpg', { eager: true });
const img = (github: string) => files[`../assets/avatars/${github}.jpg`]?.default;
---
<section id="team" class="sec psec" aria-labelledby="team-h">
  <h2 id="team-h" data-pad>Team</h2>
  <ul class="members panel">
    {members.map(({ data: m }) => {
      const face = img(m.github);
      return (
        <li class="member">
          {face ? <Image src={face} alt="" width={56} height={56} class="face" /> : <span class="face">{initialsOf(m.name)}</span>}
          <span class="who">
            <b class="nm">{m.name}</b>
            <span class="where">
              {m.website && <a href={m.website}>{m.website.replace(/^https?:\/\//, '')}</a>}
              {m.linkedin && <a href={m.linkedin}>LinkedIn</a>}
              <a href={`https://github.com/${m.github}`}>GitHub</a>
            </span>
          </span>
        </li>
      );
    })}
  </ul>
</section>
