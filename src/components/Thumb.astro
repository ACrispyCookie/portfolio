---
// A project's picture on the All projects page: its approved image or video, or its diagram.
// The box sets the size; the image is cropped to fill it (paper charts are shown whole on white).
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { diagrams } from './diagrams';
import OnFpga from './OnFpga.astro';

interface Props { project?: CollectionEntry<'projects'>; sizes: string }
const { sizes } = Astro.props;
const p = Astro.props.project?.data;
const Diagram = p?.diagram ? diagrams[p.diagram] : null;
---
<span class="thumb" aria-hidden="true">
  {p?.media?.video ? (
    <video src={p.media.video} poster={p.media.video.replace(/\.mp4$/, '.jpg')} muted loop playsinline preload="none"></video>
  ) : p?.media ? (
    <Picture src={p.media.src} formats={['avif', 'webp']} widths={[240, 400, 640, 960]} sizes={sizes} alt="" loading="lazy" class:list={{ paper: p.media.paper }} />
  ) : Diagram ? <Diagram label="" /> : <i class="pad"></i>}
  {p?.media?.overlay === 'fpga' && <OnFpga />}
</span>
