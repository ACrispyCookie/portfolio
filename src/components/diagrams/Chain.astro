---
// A chain of steps left to right, in the same board style as the other drawings: boxes joined by copper arrows,
// an optional gold tag above each joint, and optional lines of notes under the chain. The project drawings that are
// a plain sequence (the runtime's protocols, the lab's sessions and wiring, the DVD logo's video path) use it.
interface Step { lines: string[]; end?: boolean }
interface Props { label: string; steps: Step[]; tags?: (string | undefined)[]; notes?: string[]; both?: boolean }
const { label, steps, tags = [], notes = [], both = false } = Astro.props;
const F = 'Hanken Grotesk Variable, Hanken Grotesk, sans-serif';
// every word and box at least 16 units inside the frame (Jason, 2026-10-25: too little padding); 372 wide so four
// boxes still hold their words, and a phone still shows them at 13px
const VW = 372, M = 16, GAP = 16, BH = 58;
const n = steps.length, BY = tags.some(Boolean) ? 44 : M;
const W = (VW - 2 * M - (n - 1) * GAP) / n;
const bx = (i: number) => M + i * (W + GAP);
const H = BY + BH + (notes.length ? 26 + (notes.length - 1) * 19 + 20 : M);
const ay = BY + BH / 2;
---
<svg class="diagram" data-kind="chain" viewBox={`0 0 ${VW} ${H}`} role="img" aria-label={label}>
  <rect width={VW} height={H} fill="#183539" />
  <g fill="none" stroke="#3b7a82" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {steps.slice(1).map((_, i) => {
      const a = bx(i) + W + 2, b = bx(i + 1) - 2;
      return (
        <>
          <path d={`M${a} ${ay} H${b}`} />
          <path d={`M${b - 6} ${ay - 5} L${b} ${ay} L${b - 6} ${ay + 5}`} />
          {both && <path d={`M${a + 6} ${ay - 5} L${a} ${ay} L${a + 6} ${ay + 5}`} />}
        </>
      );
    })}
  </g>
  <g font-family={F} font-size="13" text-anchor="middle">
    {steps.map((s, i) => (
      <g>
        <rect x={bx(i)} y={BY} width={W} height={BH} rx="10" fill={s.end ? '#41e2f2' : '#11282d'} />
        {s.lines.map((t, li) => <text x={bx(i) + W / 2} y={BY + BH / 2 + 4.5 + (li - (s.lines.length - 1) / 2) * 16} fill={s.end ? '#05252a' : li === 0 ? '#eaf2f1' : '#9db6b8'} font-weight={s.end ? 700 : 400}>{t}</text>)}
      </g>
    ))}
    {tags.map((t, i) => t && (
      <g>
        {!both && <circle cx={bx(i) + W + GAP / 2} cy={ay} r="3.5" fill="#d8b46a" />}
        <text x={bx(i) + W + GAP / 2} y={BY - 12} fill="#d8b46a" font-weight="700">{t}</text>
      </g>
    ))}
    {notes.map((t, i) => <text x={VW / 2} y={BY + BH + 26 + i * 19} fill="#9db6b8">{t}</text>)}
  </g>
</svg>
