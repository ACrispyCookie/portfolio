---
// ECE318 deduplicating filesystem: two files whose blocks share content; each distinct block is stored once.
interface Props { label?: string }
const { label = 'Diagram: two files share blocks with the same content, and the disk stores each of those blocks once' } = Astro.props;
const cyan = '#41e2f2', gold = '#d8b46a', mint = '#86e3bd', amber = '#f0a64a', silk = '#9db6b8';
const a = [cyan, gold, mint];
const b = [gold, mint, amber, silk];
const disk = [cyan, gold, mint, amber, silk];
const ax = (i: number) => 34 + i * 30, bx = (i: number) => 170 + i * 30, dx = (i: number) => 86 + i * 32;
const at = (c: string) => disk.indexOf(c);
---
<svg class="diagram" data-kind="dedup" viewBox="0 0 320 200" role="img" aria-label={label} preserveAspectRatio="xMidYMid meet">
  <rect width="320" height="200" fill="#183539" />
  {/* the drawing 6 units higher, so its caption is clear of the bottom edge on a small card (Jason, 2026-10-25) */}
  <g transform="translate(0 -6)">
  <g font-family="Hanken Grotesk Variable, Hanken Grotesk, sans-serif">
    <text x="34" y="32" font-size="11" fill="#9db6b8">file A</text><text x="170" y="32" font-size="11" fill="#9db6b8">file B</text>
    <g fill="none" stroke="#3b7a82" stroke-width="1.5">
      {a.map((c, i) => <path d={`M${ax(i) + 12} 60 C${ax(i) + 12} 100 ${dx(at(c)) + 12} 100 ${dx(at(c)) + 12} 136`} />)}
      {b.map((c, i) => <path d={`M${bx(i) + 12} 60 C${bx(i) + 12} 100 ${dx(at(c)) + 12} 100 ${dx(at(c)) + 12} 136`} />)}
    </g>
    {a.map((c, i) => <rect x={ax(i)} y="40" width="24" height="20" rx="4" fill={c} />)}
    {b.map((c, i) => <rect x={bx(i)} y="40" width="24" height="20" rx="4" fill={c} />)}
    <rect x="74" y="128" width="172" height="40" rx="9" fill="#11282d" />
    {disk.map((c, i) => <rect x={dx(i)} y="138" width="24" height="20" rx="4" fill={c} />)}
    <text x="62" y="152" font-size="11" fill="#9db6b8" text-anchor="end">disk</text>
    <text x="160" y="188" font-size="11" fill="#9db6b8" text-anchor="middle">7 blocks written, <tspan fill="#d8b46a" font-weight="700">5 stored</tspan></text>
  </g>
  </g>
</svg>
