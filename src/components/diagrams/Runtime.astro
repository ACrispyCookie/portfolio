---
// ECE348 distributed runtime: three nodes over one shared tuple space; a running thread moves from the busiest node
// to the idlest one, leaving two on each (live migration and load balancing, from the brief).
interface Props { label?: string }
const { label = 'Diagram: a running thread moving from a busy machine to an idle one, all sharing one tuple space' } = Astro.props;
const nodes = [
  { x: 30, name: 'node 1', threads: ['#86e3bd', '#9db6b8'], gone: true },
  { x: 120, name: 'node 2', threads: ['#d8b46a', '#86e3bd'] },
  { x: 210, name: 'node 3', threads: ['#41e2f2'] },
];
---
<svg class="diagram" data-kind="runtime" viewBox="0 0 320 200" role="img" aria-label={label} preserveAspectRatio="xMidYMid meet">
  <rect width="320" height="200" fill="#183539" />
  <g font-family="Hanken Grotesk Variable, Hanken Grotesk, sans-serif">
    {nodes.map((n) => (
      <g>
        <rect x={n.x} y="44" width="80" height="90" rx="10" fill="#11282d" stroke="#3b7a82" stroke-width="1.5" />
        <text x={n.x + 12} y="62" font-size="11" fill="#9db6b8">{n.name}</text>
        {n.threads.map((c, i) => <rect x={n.x + 12} y={72 + i * 18} width="56" height="12" rx="6" fill={c} />)}
        {n.gone && <rect x={n.x + 12} y="108" width="56" height="12" rx="6" fill="none" stroke="#3b7a82" stroke-width="1.5" stroke-dasharray="3 3" />}
        <path d={`M${n.x + 40} 134 V152`} stroke="#3b7a82" stroke-width="2" />
        <circle cx={n.x + 40} cy="152" r="4" fill="#d8b46a" />
      </g>
    ))}
    {/* the move: over the top, from node 1's empty slot to node 3 */}
    <path d="M70 44 V32 Q70 22 80 22 H240 Q250 22 250 32 V40" fill="none" stroke="#d8b46a" stroke-width="2" stroke-dasharray="5 5" />
    <path d="M245 36 L250 43 L255 36" fill="none" stroke="#d8b46a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="128" y="13" width="64" height="18" rx="9" fill="#41e2f2" />
    <text x="160" y="26.5" font-size="12" font-weight="700" fill="#05252a" text-anchor="middle">running</text>
    <rect x="30" y="156" width="260" height="30" rx="8" fill="#11282d" stroke="#3b7a82" stroke-width="1.5" />
    <text x="42" y="175" font-size="11" fill="#9db6b8">shared tuple space</text>
    <g fill="#3b7a82"><rect x="166" y="165" width="26" height="12" rx="6" /><rect x="198" y="165" width="20" height="12" rx="6" /><rect x="224" y="165" width="30" height="12" rx="6" /><rect x="260" y="165" width="18" height="12" rx="6" /></g>
  </g>
</svg>
