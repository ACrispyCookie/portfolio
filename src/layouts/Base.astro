---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
// the two fonts' Latin files, fetched with the page instead of after the CSS, so the first paint already uses them and
// text doesn't rewrap and shift the page when they arrive (Lighthouse, 2026-10-24)
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import textFont from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  home?: boolean;
}
const { title, description, home = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1d21" />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    {/* iOS turns dates and numbers into white links among grey text (Jason, 2026-10-21) */}
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <slot name="head" />
  </head>
  <body>
    <TopBar home={home} />
    <div class="wrap" data-trace={home ? 'board' : 'page'}>
      <main id="top">
        <slot />
      </main>
    </div>
    <Footer home={home} />
    <slot name="scripts" />
    <script>
      import '../scripts/trace';
      import '../scripts/lab-status';
      addEventListener('load', () => document.documentElement.classList.add('glide'));
    </script>
  </body>
</html>
