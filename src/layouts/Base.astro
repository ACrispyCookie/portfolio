---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
// the text font's Latin file, fetched with the page instead of after the CSS, so the first paint already uses it and
// text doesn't rewrap and shift the page when it arrives (Lighthouse, 2026-10-24). Only this one: preloading the
// larger display font too delayed the home page's first paint (performance 88–89 instead of 92–95).
import textFont from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  /** the share image, from the site root; made absolute here (plan Task 7) */
  image?: string;
  /** false for a page search engines should leave out (the 404): no canonical, no og:url, and noindex */
  index?: boolean;
}
const { title, description, home = false, image = '/og.png', index = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(image, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1d21" />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    {/* iOS turns dates and numbers into white links among grey text (Jason, 2026-10-21) */}
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    {index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jason Nikas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {index && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {image === '/og.png' && <meta property="og:image:alt" content="Jason Nikas: I build systems from code down to hardware." />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <TopBar home={home} />
    <div class="wrap" data-trace={home ? 'board' : 'page'}>
      <main id="top">
        <slot />
      </main>
    </div>
    <Footer home={home} />
    <slot name="scripts" />
    <script>
      import '../client/trace';
      import '../client/lab-status';
      addEventListener('load', () => document.documentElement.classList.add('glide'));
    </script>
  </body>
</html>
