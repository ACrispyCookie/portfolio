---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Glance from '../components/Glance.astro';
import Projects from '../components/Projects.astro';
import People from '../components/People.astro';
import Timeline from '../components/Timeline.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
---
<Base title="Jason Nikas" description="Jason Nikas, Electrical and Computer Engineering student at the University of Thessaly. Projects from code down to hardware: GPUs on FPGAs, CUDA, filesystems and distributed runtimes." home>
  <Hero />
  <Glance />
  <Projects />
  <Timeline />
  <Skills />
  <People />
  <Contact />
  <Fragment slot="scripts">
    <script>
      import '../client/board-client';
      import '../client/pill';
      import '../client/videos';
      import '../client/skills';
      import '../client/timeline';
    </script>
  </Fragment>
</Base>
