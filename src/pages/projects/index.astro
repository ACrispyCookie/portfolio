---
// All projects (spec §4, §5.4a): every project and course on the site, as a plain list. Personal projects first,
// with the older portfolio as on home, then the courses by importance (each course's `rank`), never by grade
// (Jason, 2026-10-22 and 2026-10-23). Each course names its collaborators and shows its grade out of 10; each project
// shows its tools. Counts come from the collections.
import { getCollection, getEntries } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Thumb from '../../components/Thumb.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { toolTags } from '../../lib/tools';
import Avatars from '../../components/Avatars.astro';
import OriginCard from '../../components/OriginCard.astro';
import { courseHref, pageHref } from '../../lib/links';
import '../../styles/projects.css';
import '../../styles/all.css';

type Project = Awaited<ReturnType<typeof getCollection<'projects'>>>[number];
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const link = (p: Project) => pageHref({ ...p.data, id: p.id, course: p.data.course?.id });
const personal = projects.filter((p) => p.data.kind === 'personal');
const ofCourse = (id: string) =>
  projects.filter((p) => p.data.course?.id === id).sort((a, b) => Number(b.data.main) - Number(a.data.main) || a.data.order - b.data.order);
const courses = (await getCollection('courses')).sort((a, b) => a.data.rank - b.data.rank);
const featured = (c: (typeof courses)[number]) => projects.find((p) => p.id === c.data.featuredProject.id);
// everyone who worked on any of the course's projects, in the order they first appear
const team = async (id: string) => {
  const ids = [...new Set(ofCourse(id).flatMap((p) => p.data.team.map((t) => t.id)))];
  return ids.length ? (await getEntries(ids.map((i) => ({ collection: 'collaborators' as const, id: i })))) : [];
};
const teams = Object.fromEntries(await Promise.all(courses.map(async (c) => [c.id, await team(c.id)] as const)));
const names = (list: { data: { name: string } }[]) =>
  list.length < 2 ? list.map((p) => p.data.name).join('') : `${list.slice(0, -1).map((p) => p.data.name).join(', ')} and ${list.at(-1)!.data.name}`;
---
<Base title="Projects | Jason Nikas" description={`All ${projects.length} projects on njason.dev, from ${courses.length} university courses and my own work, with links to each one.`}>
  <header class="allhead" data-trace-start>
    <h1>Projects</h1>
    <p class="counts">{projects.length} projects and {courses.length} courses</p>
    <p class="lead">Every project on this site in one place: what I built on my own first, then each course and what came out of it.</p>
  </header>

  <section id="personal" class="sec" aria-labelledby="personal-h">
    <h2 id="personal-h" data-pad>Personal projects</h2>
    {/* the same cards as on home, with their tools (Jason, 2026-10-23: the plain tiles looked too bare) */}
    <div class="grid three personal">{personal.map((p) => <ProjectCard project={p} size="personal" tools />)}</div>
    <OriginCard />
  </section>

  <section id="courses" class="sec" aria-labelledby="courses-h">
    <h2 id="courses-h" data-pad>Courses</h2>
    <div class="courses">
      {courses.map((c) => (
        <div class="course">
          <a class="cpic" href={courseHref(c.id)} tabindex="-1" aria-hidden="true"><Thumb project={featured(c)} sizes="(max-width: 760px) 100vw, 520px" /></a>
          <div class="cbody">
            <a class="ch" href={courseHref(c.id)}><span class="cn"><b>{c.data.code}</b></span><span class="g">Grade <b>{c.data.grade}</b>&nbsp;/&nbsp;10</span><span class="n">{c.data.name}</span></a>
            {teams[c.id].length > 0 && (
              <p class="with"><Avatars handles={teams[c.id].map((p) => p.id)} /><span>With {names(teams[c.id])}</span></p>
            )}
            <ul class:list={{ two: ofCourse(c.id).length >= 3 }}>
              {ofCourse(c.id).map((p) => {
                const t = toolTags(p.data.tools);
                return (
                  <li>
                    <a href={link(p)}>{p.data.title}</a>
                    <span class="hl">{p.data.headline}</span>
                    <span class="tools">{t.shown.map((x) => <span class="tag">{x}</span>)}{t.rest.length > 0 && <span class="tag more" title={t.rest.join(', ')}>+{t.rest.length}</span>}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>
  <Fragment slot="scripts">
    <script>
      import '../../scripts/videos';
    </script>
  </Fragment>
</Base>
